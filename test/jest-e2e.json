{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "@app/abstract.db/(.*)": "<rootDir>/../libs/abstract.db/src/$1",
    "@app/abstract.db": "<rootDir>/../libs/abstract.db/src",
    "@app/abstract.mongo/(.*)": "<rootDir>/../libs/abstract.mongo/src/$1",
    "@app/abstract.mongo": "<rootDir>/../libs/abstract.mongo/src",
    "@app/decorators/(.*)": "<rootDir>/../libs/decorators/src/$1",
    "@app/decorators": "<rootDir>/../libs/decorators/src",
    "@app/configurations/(.*)": "<rootDir>/../libs/configurations/src/$1",
    "@app/configurations": "<rootDir>/../libs/configurations/src",
    "@app/enums/(.*)": "<rootDir>/../libs/enums/src/$1",
    "@app/enums": "<rootDir>/../libs/enums/src",
    "@app/constants/(.*)": "<rootDir>/../libs/constants/src/$1",
    "@app/constants": "<rootDir>/../libs/constants/src",
    "@app/dtos/(.*)": "<rootDir>/../libs/dtos/src/$1",
    "@app/dtos": "<rootDir>/../libs/dtos/src",
    "@app/middlewares/(.*)": "<rootDir>/../libs/middlewares/src/$1",
    "@app/middlewares": "<rootDir>/../libs/middlewares/src",
    "@app/email/(.*)": "<rootDir>/../libs/email/src/$1",
    "@app/email": "<rootDir>/../libs/email/src",
    "@app/interceptors/(.*)": "<rootDir>/../libs/interceptors/src/$1",
    "@app/interceptors": "<rootDir>/../libs/interceptors/src"
  }
}